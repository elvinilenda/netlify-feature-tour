            "format": "binary",
            "title": "Arquivo",
            "description": "Processo PDF pesquisável, até 70 MB"
          },
          "fase": {
            "type": "string",
            "enum": [
              "liquidacao",
              "execucao"
            ],
            "title": "Fase",
            "default": "liquidacao"
          },
          "pagina_sentenca": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Pagina Sentenca",
            "default": 0
          },
          "numero_cnj": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Numero Cnj"
          }
        },
        "type": "object",
        "required": [
          "arquivo"
        ],
        "title": "Body_analisar_pdf_endpoint_api_v1_analisar_pdf_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TextoEntrada": {
        "properties": {
          "texto": {
            "type": "string",
            "maxLength": 5000000,
            "minLength": 10,
            "title": "Texto",
            "description": "Texto dos autos com [PÁGINA N] ou quebras de página."
          },
          "fase": {
            "type": "string",
            "enum": [
              "liquidacao",
              "execucao"
            ],
            "title": "Fase",
            "default": "liquidacao"
          },
          "pagina_sentenca": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 0.0,
